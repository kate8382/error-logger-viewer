{
  "name": "error-logger-viewer",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "jest --runInBand",
    "test:frontend": "jest --selectProjects frontend --runInBand",
    "test:backend": "jest --selectProjects backend --runInBand",
    "lint:all": "concurrently \"npm --workspace=frontend run lint\" \"npm --workspace=backend run lint\"",
    "install:all": "npm install",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "start:all": "concurrently \"npm --workspace=backend run dev\" \"npm --workspace=frontend run dev\"",
    "ts:check": "node node_modules/typescript/bin/tsc -p frontend/tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p backend/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.29.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.4.2",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "babel-jest": "^30.2.0",
    "concurrently": "^7.6.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0"
  },
  "overrides": {
    "test-exclude": {
      "glob": "^10.5.0"
    },
    "glob": "^10.5.0",
    "rimraf": "^4.0.0"
  }
}
