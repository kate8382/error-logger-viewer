{
  "name": "error-logger-viewer",
  "author": "Ecaterina Sevciuc",
  "license": "MIT",
  "description": "Error logger viewer application with backend server",
  "homepage": "https://kate8382.github.io/error-logger-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "install:all": "npm install",
    "dev:backend": "nodemon backend/server.js",
    "start:backend": "node backend/server.js",
    "dev:frontend": "webpack serve --config webpack.config.cjs --mode development",
    "start:frontend": "webpack-dev-server --config webpack.config.cjs --open",
    "watch:frontend": "webpack --config webpack.config.cjs --watch",
    "build:frontend": "webpack --config webpack.config.cjs --mode production",
    "serve:dist:frontend": "http-server dist -p 8080 -c-1",
    "start:all": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "test": "jest --runInBand",
    "test:frontend": "jest --selectProjects frontend --runInBand",
    "test:backend": "jest --selectProjects backend --runInBand",
    "test:coverage:frontend": "cd frontend && npm run test -- --coverage --coverageDirectory=../coverage/frontend",
    "test:coverage:backend": "npm --prefix backend run test -- --coverage --coverageDirectory=coverage/backend",
    "coverage:all": "npm run test:coverage:backend && npm run test:coverage:frontend",
    "lint:all": "concurrently \"npm run lint:frontend\" \"npm run lint:backend\"",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "ts:check": "node node_modules/typescript/bin/tsc -p frontend/tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p backend/tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lowdb": "^7.0.1",
    "uuid": "^11.1.0",
    "chart.js": "^4.5.0",
    "core-js": "^3.44.0",
    "redom": "^4.3.0",
    "regenerator-runtime": "^0.14.1"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@eslint/js": "^9.29.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.4.2",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "babel-jest": "^30.2.0",
    "concurrently": "^7.6.0",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.2.0",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.6.2",
    "ts-jest": "^29.1.0",
    "typescript": "^5.4.0",
    "nodemon": "^3.1.10",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^13.0.0",
    "css-loader": "^7.1.2",
    "cypress": "^15.0.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "webpack": "^5.100.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  },
  "overrides": {
    "test-exclude": {
      "glob": "^10.5.0"
    },
    "glob": "^10.5.0",
    "rimraf": "^4.0.0"
  }
}
