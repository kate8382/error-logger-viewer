{
  "name": "error-logger-viewer",
  "keywords": [
    "error-logger-viewer",
    "error logger",
    "error viewer",
    "errors",
    "error",
    "logger",
    "viewer",
    "frontend",
    "backend",
    "cypress",
    "e2e",
    "testing"
  ],
  "author": "Ecaterina Sevciuc",
  "contributors": [
    {
      "name": "Manuja Senanayake",
      "email": "manuja.net@gmail.com"
    }
  ],
  "license": "MIT",
  "description": "Error logger viewer application with backend server",
  "homepage": "https://kate8382.github.io/error-logger-viewer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "patch-package",
    "install:all": "npm install",
    "build:types": "tsc -p tsconfig.types.json",
    "build:backend": "npm run build:types && tsc -p backend/tsconfig.json",
    "build:frontend": "npm run build:types && webpack --config webpack.config.cjs --mode production",
    "watch:frontend": "webpack --config webpack.config.cjs --watch",
    "dev:backend": "nodemon --watch backend/src --ext ts --exec \"npm run build:backend && node backend/dist/server.js\"",
    "dev:frontend": "webpack serve --config webpack.config.cjs --mode development",
    "serve:dist:frontend": "http-server frontend/dist -p 8080 -c-1",
    "start:backend": "node backend/dist/server.js",
    "start:frontend": "webpack serve --config webpack.config.cjs --open",
    "start:all": "npm run build:backend && concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run build:backend && node backend/dist/server.js",
    "test": "npm run test:frontend && npm run test:backend",
    "test:frontend": "node ./scripts/run-frontend-tests.cjs",
    "test:backend": "node node_modules/jest/bin/jest.js --selectProjects backend --runInBand",
    "test:e2e:local": "npx cypress run --config-file tests/e2e/cypress.config.ts",
    "test:e2e:docker": "bash -lc 'docker run --rm -v \"$(pwd):/e2e\" -w /e2e -e CYPRESS_BASE_URL --entrypoint bash cypress/included:12.17.4 -lc \"npm ci --no-audit --prefer-offline && npx cypress run --config baseUrl=\\\"${CYPRESS_BASE_URL:-http://static-frontend:80}\\\" --config-file tests/e2e/cypress.config.ts\"'",
    "test:e2e": "npm run test:e2e:local",
    "test:e2e:open": "npx cypress open --config-file tests/e2e/cypress.config.ts",
    "test:coverage:frontend": "npm run build:types && jest --selectProjects frontend --coverage",
    "test:coverage:backend": "npm run build:backend && jest --selectProjects backend --coverage",
    "coverage:all": "jest --coverage --coverageDirectory=coverage",
    "lint:all": "concurrently \"npm run lint:frontend\" \"npm run lint:backend\"",
    "lint:frontend": "cd frontend && npm run lint",
    "lint:backend": "cd backend && npm run lint",
    "ts:check": "node node_modules/typescript/bin/tsc -p frontend/tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p backend/tsconfig.json --noEmit",
    "ts:check:unit": "node node_modules/typescript/bin/tsc -p tsconfig.tests.json --noEmit",
    "ts:check:e2e": "node node_modules/typescript/bin/tsc -p tests/e2e/tsconfig.json --noEmit",
    "dev:docker": "docker compose -f docker/docker-compose.dev.yml up --build",
    "prod:docker": "docker compose -f docker/docker-compose.yml up --build -d"
  },
  "dependencies": {
    "chart.js": "^4.5.0",
    "core-js": "^3.44.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "lowdb": "^7.0.1",
    "redom": "^4.3.0",
    "regenerator-runtime": "^0.14.1",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-typescript": "^7.28.5",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@eslint/js": "^9.29.0",
    "@types/cors": "^2.8.19",
    "@types/cypress": "^1.1.6",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.5.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^8.50.0",
    "@typescript-eslint/parser": "^8.50.0",
    "babel-jest": "^30.2.0",
    "babel-loader": "^10.0.0",
    "concurrently": "^7.6.0",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "cypress": "^15.14.2",
    "esbuild": "0.28.1",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-prettier": "^5.5.4",
    "globals": "^16.2.0",
    "html-webpack-plugin": "^5.6.3",
    "jest": "^30.4.1",
    "jest-environment-jsdom": "^30.2.0",
    "jest-haste-map": "30.4.0",
    "jest-util": "^30.4.1",
    "mini-css-extract-plugin": "^2.9.2",
    "nodemon": "^3.1.10",
    "patch-package": "^8.0.1",
    "prettier": "^3.6.2",
    "sass": "^1.89.2",
    "sass-loader": "^16.0.5",
    "style-loader": "^4.0.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3",
    "webpack": "^5.100.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.3"
  },
  "overrides": {
    "test-exclude": {
      "glob": "^10.5.0"
    },
    "glob": "^10.5.0",
    "router": {
      "path-to-regexp": "^8.4.2"
    },
    "rimraf": "^4.0.0"
  }
}
