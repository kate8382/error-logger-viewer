{
  "name": "error-logger-viewer",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev:backend": "npm --workspace=backend run dev",
    "dev:frontend": "npm --workspace=frontend run dev",
    "start:all": "concurrently \"npm --workspace=backend run dev\" \"npm --workspace=frontend run dev\"",
    "ts:check": "node node_modules/typescript/bin/tsc -p frontend/tsconfig.json --noEmit && node node_modules/typescript/bin/tsc -p backend/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^20.4.2",
    "@eslint/js": "^9.29.0",
    "typescript": "^5.4.0",
    "ts-node-dev": "^2.0.0",
    "eslint": "^9.29.0",
    "prettier": "^3.6.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-jest": "^29.0.1",
    "globals": "^16.2.0",
    "concurrently": "^7.6.0"
  }
}
