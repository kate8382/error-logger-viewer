{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "typeRoots": ["../types", "../node_modules/@types"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["src/**/*"],
  "files": ["../types/global.d.ts"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
