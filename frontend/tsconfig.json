{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",
    "module": "ES2022",
    "lib": ["ES2022", "DOM"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true
  },
  "include": ["src/**/*", "../types/**/*.d.ts"],
  // "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.d.ts"],
  // "include": ["src/**/*", "src/scripts/types/**/*"],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
