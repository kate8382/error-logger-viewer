{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "types": ["node", "jest", "cypress"],
    "typeRoots": ["./node_modules/@types", "./types"]
  },
  "include": [
