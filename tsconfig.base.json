{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "typeRoots": ["./types", "./node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@types/*": ["types/dist/*"],
      "api": ["types/dist/api"],
      "projects": ["types/dist/projects"],
      "errors": ["types/dist/errors"],
      "users": ["types/dist/users"]
    },
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "jest"]
  }
}
