{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "noEmit": true, // для проверки типов без генерации файлов
    "esModuleInterop": true,
    "typeRoots": ["./types", "./node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@types/*": ["types/dist/*"],
      "api": ["types/dist/api"],
      "projects": ["types/dist/projects"],
      "errors": ["types/dist/errors"],
      "users": ["types/dist/users"]
    },
    "forceConsistentCasingInFileNames": true, // для предотвращения проблем с регистром в именах файлов
    "strict": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "resolveJsonModule": true,
    "types": ["node", "jest"]
  }
  ,
  "exclude": ["types"]

  ,
  "files": ["types/global.d.ts", "types/modules.d.ts"]
}
